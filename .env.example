# --- Telegram ---
# Токен от @BotFather
BOT_TOKEN=
# id закрытого канала (число вида -100...). Узнать: добавить бота админом и написать в канал /chatid
CHANNEL_ID=
# id приватной группы преподавателя, куда падают вопросы учеников. Можно оставить пустым.
QUESTIONS_CHAT_ID=
# Числовые id преподавателя и разработчика через запятую (узнать у @userinfobot)
ADMIN_IDS=

# --- ЮKassa ---
# Личный кабинет -> Интеграция -> Ключи API. Для проверки возьмите ключи ТЕСТОВОГО магазина.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# 1 — передавать данные для чека (если подключены «Чеки от ЮKassa»); бот тогда спросит e-mail.
# 0 — чеки формируются иначе (своя касса, «Мой налог») или не нужны.
YOOKASSA_SEND_RECEIPT=0
# Ставка НДС в чеке: 1 — без НДС (см. справочник значений ЮKassa)
VAT_CODE=1
# Код системы налогообложения, если ЮKassa его требует; обычно пусто
TAX_SYSTEM_CODE=

# --- Тариф ---
PRICE_RUB=990
SUB_DAYS=30
TRIAL_DAYS=3
# Как услуга называется в счёте и в чеке
PRODUCT_NAME=Доступ к закрытому каналу

# --- Прочее ---
# Ссылка на оферту / политику обработки данных (показывается перед оплатой)
OFFER_URL=
# Куда писать, если что-то сломалось, например @username
SUPPORT_CONTACT=
# 1 — вопросы принимаются только от тех, у кого есть доступ к каналу
QUESTIONS_SUBSCRIBERS_ONLY=1
DB_PATH=data/bot.sqlite3
# Прокси до api.telegram.org, если с сервера он недоступен: socks5://user:pass@host:port
PROXY_URL=
TZ_NAME=Europe/Moscow
